<Window x:Class="SongSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SongSwitcher.ViewModels"
        Icon="Assets/app.ico"
        Title="Song Switcher - 歌曲快捷切换"
        Height="660" Width="1020"
        MinHeight="480" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8">

    <Window.Resources>
        <!-- 取反转换器：用于"刷新中禁用下拉框" -->
        <local:InverseBoolConverter xmlns:local="clr-namespace:SongSwitcher" x:Key="InverseBool" />

        <!-- ================= 设计令牌 ================= -->
        <SolidColorBrush x:Key="Accent" Color="#2F6FED" />
        <SolidColorBrush x:Key="AccentHover" Color="#4B84F0" />
        <SolidColorBrush x:Key="AccentPressed" Color="#2059C8" />
        <SolidColorBrush x:Key="AccentSoft" Color="#F4F7FF" />
        <SolidColorBrush x:Key="AccentSoftStrong" Color="#E8F0FE" />
        <SolidColorBrush x:Key="AccentBorder" Color="#AFC6F3" />
        <SolidColorBrush x:Key="Stroke" Color="#E3E6EC" />
        <SolidColorBrush x:Key="StrokeStrong" Color="#D8DEE9" />
        <SolidColorBrush x:Key="Ink" Color="#3C4250" />
        <SolidColorBrush x:Key="InkMuted" Color="#8A90A0" />
        <SolidColorBrush x:Key="Danger" Color="#D93025" />
        <SolidColorBrush x:Key="DangerSoft" Color="#FEF2F1" />
        <SolidColorBrush x:Key="DangerSoftStrong" Color="#FBE3E1" />
        <SolidColorBrush x:Key="DangerBorder" Color="#F3B8B4" />
        <SolidColorBrush x:Key="WarmSoft" Color="#FDF0E3" />
        <SolidColorBrush x:Key="WarmBorder" Color="#E8C9A0" />
        <SolidColorBrush x:Key="WarmInk" Color="#B4690E" />
        <SolidColorBrush x:Key="DisabledBg" Color="#F2F3F5" />
        <SolidColorBrush x:Key="DisabledInk" Color="#B4BAC5" />

        <!-- ================= 按钮：主操作（蓝底白字） ================= -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#4B84F0" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Stroke}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 按钮：次操作（白底细边） ================= -->
        <Style x:Key="BtnSecondary" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource StrokeStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#F4F7FF" Duration="0:0:0.12" FillBehavior="Stop" />
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#AFC6F3" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Stroke}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 按钮：危险操作（白底红字） ================= -->
        <Style x:Key="BtnDanger" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Foreground" Value="{StaticResource Danger}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource DangerBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#FEF2F1" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DangerSoftStrong}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Danger}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Stroke}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 按钮：小号次级（卡片内 / 刷新） ================= -->
        <Style x:Key="BtnGhostSmall" TargetType="Button" BasedOn="{StaticResource BtnSecondary}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="BtnDangerSmall" TargetType="Button" BasedOn="{StaticResource BtnDanger}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- ================= 按钮：图标方钮（32x32，无填充感） ================= -->
        <Style x:Key="BtnIcon" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#5A6270" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#F4F7FF" Duration="0:0:0.12" FillBehavior="Stop" />
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#AFC6F3" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Stroke}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放模式开关：底色随模式变化（蓝=列表循环 / 暖橙=单曲循环 / 白=一次播放） -->
        <Style x:Key="BtnIconPlayMode" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Content" Value="{Binding PlayModeIcon}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- 模式色声明在前，hover/pressed 声明在后即可覆盖 -->
                            <DataTrigger Binding="{Binding PlayMode}" Value="RepeatAll">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PlayMode}" Value="RepeatOne">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarmSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource WarmBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource WarmInk}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#F4F7FF" Duration="0:0:0.12" FillBehavior="Stop" />
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#AFC6F3" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 静音开关：静音时图标与文字变红 -->
        <Style x:Key="BtnIconMute" TargetType="Button" BasedOn="{StaticResource BtnIcon}">
            <Setter Property="Content" Value="🔊" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                <Setter Property="Content" Value="🔇" />
                                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource DangerBorder}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="Background.Color"
                                                            To="#F4F7FF" Duration="0:0:0.12" FillBehavior="Stop" />
                                            <ColorAnimation Storyboard.TargetName="Bd"
                                                            Storyboard.TargetProperty="BorderBrush.Color"
                                                            To="#AFC6F3" Duration="0:0:0.12" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 复选框（小圆角方块 + 对勾） ================= -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4"
                                    Background="White" BorderBrush="{StaticResource StrokeStrong}"
                                    BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="Chk" Data="M 3.8,8.2 L 6.8,11.2 L 12.2,3.8"
                                      Stroke="White" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Visibility="Hidden" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="8,0,0,0"
                                              VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter TargetName="Chk" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource DisabledBg}" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 下拉框（扁平细边 + 圆角弹层） ================= -->
        <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
            <Border Background="Transparent" />
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" CornerRadius="6" SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- 选中项显示：必须显式绑定 SelectionBoxItem/Template，
                                         否则 ContentPresenter 没有 Content，框里是一片空白 -->
                                    <ContentPresenter x:Name="ContentSite" Margin="12,0,32,0"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      IsHitTestVisible="False"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                    <Path Data="M 0,1.5 L 4.5,6 L 9,1.5" Stroke="#8A90A0" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Margin="0,0,12,0" IsHitTestVisible="False" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Template="{StaticResource ComboToggleTemplate}" />
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   StaysOpen="False" PopupAnimation="Fade"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border x:Name="DropDown" Background="White" BorderBrush="{StaticResource Stroke}"
                                        BorderThickness="1" CornerRadius="8" Padding="4"
                                        MinWidth="{Binding ActualWidth, ElementName=Bd}">
                                    <ScrollViewer MaxHeight="320">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#F7F8FA" />
                                <Setter Property="Foreground" Value="{StaticResource DisabledInk}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= 滑块（细轨道 + 圆形白点拇指） ================= -->
        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <!-- 轨道底槽 -->
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Stroke}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="{StaticResource Accent}" HorizontalAlignment="Left" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" Stroke="{StaticResource Accent}"
                                                         StrokeThickness="2.5" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Thumb" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 卡片右键菜单。
             注意绑定路径：PlacementTarget 是 ListBoxItem，其 DataContext 是 Song（数据对象，
             没有命令）；命令都在 MainWindow 的 ViewModel 上。ListBoxItem 的 Tag 经
             ItemContainerStyle 绑定到 ListBox 的 DataContext（即 ViewModel），
             因此命令走 PlacementTarget.Tag.xxx，参数走 PlacementTarget.DataContext（Song）。 -->
        <ContextMenu x:Key="CardMenu">
            <MenuItem Header="播放 / 暂停" Command="{Binding PlacementTarget.Tag.ToggleCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="设置快捷键…" Command="{Binding PlacementTarget.Tag.StartCaptureCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <MenuItem Header="清除快捷键" Command="{Binding PlacementTarget.Tag.ClearHotkeyCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
            <Separator />
            <MenuItem Header="从曲库移除…" Foreground="#D93025"
                      Command="{Binding PlacementTarget.Tag.RemoveCommand,
                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <!-- 空格键走全局热键（见 MainViewModel.RegisterAllHotkeys），
             这里不能再绑 KeyBinding，否则窗口有焦点时会触发两次 -->
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding ImportCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="14"
               PreviewKeyDown="Window_PreviewKeyDown"
               PreviewKeyUp="Window_PreviewKeyUp">
        <!-- 顶部工具栏 -->
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="10" Padding="14" Margin="0,0,0,12"
                BorderBrush="#E3E6EC" BorderThickness="1">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="歌曲快捷切换器" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="Ctrl+O 导入 · F2 设置快捷键 · 空格 播放/暂停 · 快捷键可只按一个键"
                               Foreground="#8A90A0" VerticalAlignment="Center" FontSize="12" Margin="12,0,0,0" />
                </StackPanel>

<StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="导入歌曲" Command="{Binding ImportCommand}" Style="{StaticResource BtnPrimary}" />
                            <Button Content="播放 / 暂停" Command="{Binding PlayPauseCommand}" Style="{StaticResource BtnPrimary}" />
                            <Button Content="保存曲库" Command="{Binding SaveCommand}" Style="{StaticResource BtnSecondary}" />
                            <Button Content="清空曲库" Command="{Binding RemoveAllCommand}" Style="{StaticResource BtnDanger}" />
                            <CheckBox Content="空格键全局播放/暂停" VerticalAlignment="Center" Margin="8,0,0,0"
                                      IsChecked="{Binding UseGlobalSpaceHotkey, Mode=TwoWay}"
                                      ToolTip="开启后空格键在所有程序中都触发播放/暂停（其他程序将无法输入空格）。若影响其他软件，请取消勾选。" />
                        </StackPanel>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding NowPlayingText}" FontSize="13" />
                        <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="#8A90A0" />
                        <TextBlock Text="{Binding HotkeySummary}" FontSize="12" Foreground="#2F6FED"
                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="输出设备" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="DeviceCombo"
                                      Width="230"
                                      FontSize="12"
                                      ItemsSource="{Binding OutputDevices}"
                                      SelectedItem="{Binding SelectedOutputDevice, Mode=TwoWay}"
                                      IsEnabled="{Binding IsRefreshingDevices, Converter={StaticResource InverseBool}}"
                                      ToolTip="选择音频输出设备，切换时正在播放的歌会从当前位置在新设备上继续">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="刷新" Style="{StaticResource BtnGhostSmall}" Margin="8,0,0,0"
                                    Command="{Binding RefreshDevicesCommand}"
                                    ToolTip="重新扫描输出设备（插拔耳机/声卡后使用）" />
                        </StackPanel>

                        <!-- 音量 -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <!-- 播放模式开关：点一次切换一种（一次播放 → 单曲循环 → 列表循环） -->
                            <Button Style="{StaticResource BtnIconPlayMode}" Margin="0,0,8,0"
                                    Command="{Binding TogglePlayModeCommand}"
                                    ToolTip="播放模式开关：点击在「一次播放 → 单曲循环 → 列表循环」之间切换" />
                            <Button Style="{StaticResource BtnIconMute}"
                                    Command="{Binding ToggleMuteCommand}"
                                    ToolTip="静音 / 取消静音（保留当前音量）" />
                            <Slider x:Name="VolumeSlider"
                                    Style="{StaticResource FlatSlider}"
                                    Width="180"
                                    Margin="8,0,0,0"
                                    Minimum="0" Maximum="1"
                                    SmallChange="0.02" LargeChange="0.1"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding Volume, Mode=TwoWay}"
                                    PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                                    PreviewMouseWheel="VolumeSlider_PreviewMouseWheel"
                                    ToolTip="音量（0~100），可用上下方向键微调" />
                            <TextBlock Text="{Binding VolumeText}" VerticalAlignment="Center"
                                       FontSize="12" Margin="8,0,0,0" MinWidth="34"
                                       Foreground="#8A90A0" />
                            <TextBlock Text="{Binding PlayModeText}" VerticalAlignment="Center"
                                       FontSize="12" Margin="8,0,0,0" MinWidth="46"
                                       Foreground="#8A90A0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="13" HorizontalAlignment="Right"
                                       Text="{Binding PositionText}" />
                            <TextBlock FontSize="12" Foreground="#8A90A0" HorizontalAlignment="Right" Margin="12,0,0,0"
                                       Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Slider x:Name="ProgressSlider" Style="{StaticResource FlatSlider}"
                        Minimum="0" Maximum="100" Margin="0,8,0,0"
                        Value="{Binding ProgressPercent, Mode=OneWay}"
                        PreviewMouseLeftButtonUp="ProgressSlider_PreviewMouseLeftButtonUp" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12" Foreground="#8A90A0" TextWrapping="Wrap"
                   Text="按住卡片拖动可调整顺序（拖动时会浮起一张卡片跟随指针），或选中后按 Ctrl+方向键（Ctrl+Home/End 移到首尾）。点【设键】可只按单键（如 Q、F5），也可组合（Esc 取消）。空格键默认是全局播放/暂停，不绑定到单曲上。【除键】只清快捷键，【删除】把歌曲移出曲库（磁盘文件保留）。" />

        <!-- 宫格视图 -->
        <ListBox x:Name="SongList"
                 ItemsSource="{Binding Songs}"
                 SelectedItem="{Binding SelectedSong}"
                 Background="Transparent" BorderThickness="0"
                 PreviewMouseRightButtonDown="Card_PreviewMouseRightButtonDown"
                 PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                 MouseMove="Card_MouseMove"
                 MouseLeftButtonUp="Card_MouseLeftButtonUp"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <!-- Tag 指向 ViewModel：右键菜单的命令都挂在 VM 上，
                         而菜单的 PlacementTarget 是 ListBoxItem（DataContext 是 Song） -->
                    <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                    <Setter Property="ContextMenu" Value="{StaticResource CardMenu}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd" Background="White" CornerRadius="10" Padding="12"
                                        BorderBrush="#E9ECF1" BorderThickness="1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FAFBFD" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#DCE0E8" />
                                    </Trigger>
                                    <!-- 选中态：1px 细边框 + 极淡蓝底，不加粗描边也不加色条 -->
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F4F7FF" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#AFC6F3" />
                                        <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                    </Trigger>
                                    <!-- 拖拽中：原卡片降级为占位（配合代码里的半透明淡化，形成"空槽"观感） -->
                                    <DataTrigger Binding="{Binding IsDragPlaceholder}" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#F7F9FD" />
                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#C6D2EA" />
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="228">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" />
                        <TextBlock FontSize="11" Margin="0,2,0,0" Foreground="#8A90A0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding DurationText}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Exists}" Value="False">
                                            <Setter Property="Text" Value="⚠ 文件已丢失" />
                                            <Setter Property="Foreground" Value="#D93025" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Border CornerRadius="6" Padding="8,4" Margin="0,10,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EEF3FE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Hotkey}" Value="">
                                            <Setter Property="Background" Value="#F2F3F5" />
                                        </DataTrigger>
                                        <!-- 单键模式用暖色底标出，提示它会全局抢占按键 -->
                                        <DataTrigger Binding="{Binding IsSingleKeyHotkey}" Value="True">
                                            <Setter Property="Background" Value="#FDF0E3" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#2F6FED" />
                                        <Setter Property="Text" Value="{Binding Hotkey}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Hotkey}" Value="">
                                                <Setter Property="Foreground" Value="#8A90A0" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Text" Value="未设置快捷键" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSingleKeyHotkey}" Value="True">
                                                <Setter Property="Foreground" Value="#B4690E" />
                                                <Setter Property="ToolTip" Value="单键快捷键：全局生效，会抢占该按键" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="播放" Style="{StaticResource BtnGhostSmall}"
                                    Command="{Binding DataContext.ToggleCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="设键" Style="{StaticResource BtnGhostSmall}"
                                    Command="{Binding DataContext.StartCaptureCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="除键" Style="{StaticResource BtnGhostSmall}"
                                    ToolTip="只清除该曲的快捷键，歌曲仍保留在列表中"
                                    Command="{Binding DataContext.ClearHotkeyCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                            <Button Content="删除" Style="{StaticResource BtnDangerSmall}" Margin="0"
                                    ToolTip="从曲库移除这首歌曲（磁盘文件不会被删除）"
                                    Command="{Binding DataContext.RemoveCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>